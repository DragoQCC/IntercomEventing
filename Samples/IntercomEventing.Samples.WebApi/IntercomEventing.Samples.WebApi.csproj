<Project Sdk="Microsoft.NET.Sdk.Web">

    <!--
      Sample ASP.NET Core Minimal API that uses IntercomEventing from hosted services, endpoints and a Server-Sent Events
      stream. It is part of IntercomEventing.slnx so the solution build keeps it compiling against the current library,
      and it is never packed.
    -->
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <!-- The Web SDK makes web apps non-packable and warns when "dotnet pack IntercomEventing.slnx" (CI) reaches one. -->
        <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
    </PropertyGroup>

    <ItemGroup>
        <!-- An app installs the IntercomEventing package instead. -->
        <ProjectReference Include="..\..\IntercomEventing\IntercomEventing.csproj" />
    </ItemGroup>

</Project>
