<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <BasePath />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["IntercomEventing.Samples.BlazorServer.styles.css"]" />
    <ImportMap />
    @* every page is interactive on the server; pages are still prerendered first, and IntercomEventing.Blazor subscribes nothing
       while prerendering, so only the interactive instance of a component holds subscriptions *@
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
