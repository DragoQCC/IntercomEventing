<div class="card">
    <h2>Live reading</h2>
    @if (Latest is null)
    {
        <p class="muted">Waiting for the first reading…</p>
    }
    else
    {
        <div class="reading @(Latest.IsHot ? "hot" : null)">@Latest.Celsius.ToString("0.0") °C</div>
        <p class="muted">
            @Latest.SensorName at @Latest.MeasuredAt.ToLocalTime().ToString("HH:mm:ss.f") · @UpdatesReceived update(s) received ·
            @DroppedOfferCount reading(s) skipped by the throttle since the previous update
        </p>
        <div class="sparkline">
            @foreach (var reading in History)
            {
                <div class="@(reading.IsHot ? "hot" : null)" style="height: @BarHeightPercent(reading)%"></div>
            }
        </div>
    }
</div>
