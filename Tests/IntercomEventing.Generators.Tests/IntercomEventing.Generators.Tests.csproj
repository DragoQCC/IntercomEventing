<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- TUnit test projects are Microsoft.Testing.Platform executables (dotnet test or dotnet run). -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="TUnit" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\IntercomEventing\IntercomEventing.csproj" />
        <!--
          Referenced twice on purpose: as an assembly, so tests can drive the generator with CSharpGeneratorDriver, and as
          an analyzer, so the [IntercomEvent] fixtures in this project are compiled through the real generator.
        -->
        <ProjectReference Include="..\..\IntercomEventing.Generators\IntercomEventing.Generators.csproj" />
        <ProjectReference Include="..\..\IntercomEventing.Generators\IntercomEventing.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
