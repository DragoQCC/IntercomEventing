<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    IntercomEventing packages come only from the folder "dotnet pack" writes to (./packages at the repository root, as in
    CI), never from nuget.org, so the build tests the packages this commit produced even when nuget.org has the same version.
  -->
  <packageSources>
    <clear />
    <add key="packed" value="../../packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="packed">
      <package pattern="IntercomEventing" />
      <package pattern="IntercomEventing.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
