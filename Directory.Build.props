<Project>
    <!--
      Settings that every project in this repository shares. Add a property here only when all projects should get the
      same value. Anything that differs per project (TargetFramework, LangVersion, Title, Description, IsPackable,
      OutputType) stays in that project's .csproj, and package versions belong in Directory.Packages.props.
    -->
    <PropertyGroup>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <!--
          Version of every IntercomEventing package; change it deliberately. Each push to master runs the publish workflow,
          which pushes to nuget.org with skip-duplicate, so a push that leaves this unchanged publishes nothing new.
          It stays a prerelease while the build uses the .NET 11 RC SDK and RC Microsoft packages: a stable package that
          depends on a prerelease one gets NU5104, which the WarningsAsErrors entry below turns into a pack failure, so a
          stable version cannot be published early by mistake (nuget.org never lets a published version be replaced).
        -->
        <Version>2.0.0-preview.1</Version>
        <WarningsAsErrors>$(WarningsAsErrors);NU5104</WarningsAsErrors>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Metadata shared by every published package. Each packable project adds its own Title and Description. -->
        <Authors>Jon Owens</Authors>
        <PackageProjectUrl>https://github.com/DragoQCC/IntercomEventing</PackageProjectUrl>
        <RepositoryUrl>https://github.com/DragoQCC/IntercomEventing</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <!-- The license the README states; the LICENSE file at the repository root holds its text. -->
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>
</Project>
