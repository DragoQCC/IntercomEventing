<Project>
    <!--
      Central package management: every PackageReference in this repository takes its version from a PackageVersion
      below, so a .csproj names only the package (plus PrivateAssets/IncludeAssets metadata where it needs them).
      Changing a version here changes it for every project that references the package.
    -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <!--
      Packages referenced by the published libraries. These versions become the minimum dependency versions in the
      .nupkg files, so changing one changes what consumers must restore. The core library has no package dependencies:
      on net11.0 the Microsoft.Extensions.DependencyInjection abstractions are part of the shared framework.
    -->
    <ItemGroup Label="Libraries">
        <!-- Matches the .NET 11 release the repository builds against (global.json); bump both together. -->
        <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

    <!--
      The source generator is a Roslyn plug-in that the compiler loads into its own process. It is built against a
      Roslyn version older than any compiler that can build net11.0 projects, so every such compiler loads it; a plug-in
      built against a newer Roslyn than the running compiler is skipped with a warning.
    -->
    <ItemGroup Label="Generator">
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" />
    </ItemGroup>

    <ItemGroup Label="Tests">
        <PackageVersion Include="TUnit" Version="1.75.0" />
        <PackageVersion Include="bunit" Version="2.11.3" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>

    <!-- Packages used only by the benchmark and example project. It is not published. -->
    <ItemGroup Label="Benchmarks">
        <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
        <PackageVersion Include="Microsoft.Extensions.Hosting" Version="11.0.0-rc.1.26425.128" />
    </ItemGroup>
</Project>
